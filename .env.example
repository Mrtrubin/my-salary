# 环境变量模板。复制并按环境填写：
#   cp .env.example .env.development   # 开发环境（next dev 自动加载）
#   cp .env.example .env.production    # 生产环境（next build/start 自动加载）
#
# 注意：
#  - 只需 NEXT_PUBLIC_ 前缀的变量才会暴露给浏览器。
#  - 用 publishable key（sb_publishable_...），严禁放 service_role key。
#  - .env.local 优先级最高、会覆盖所有环境，多环境部署时建议不要提交它。

# 开发环境
NEXT_PUBLIC_SUPABASE_URL=https://dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dev_your_key

# 生产环境（仅构建/运行时加载，与上面二选一按对应文件填写）
# NEXT_PUBLIC_SUPABASE_URL=https://prod-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_prod_your_key

# 可选：部署到非根路径时设置，如 /my-salary
# NEXT_PUBLIC_BASE_PATH=